  "fixed_sql": [
    {
      "name": "profile",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"profile\" (\"id\" INTEGER NOT NULL DEFAULT 1, \"name\" TEXT NOT NULL DEFAULT 'Explorer', \"grade\" INTEGER NOT NULL DEFAULT 3, \"avatar_id\" TEXT NOT NULL DEFAULT 'boy_cap', \"joined_at\" TEXT NOT NULL, \"onboarded\" INTEGER NOT NULL DEFAULT 0 CHECK (\"onboarded\" IN (0, 1)), \"sound_on\" INTEGER NOT NULL DEFAULT 1 CHECK (\"sound_on\" IN (0, 1)), \"auto_read\" INTEGER NOT NULL DEFAULT 1 CHECK (\"auto_read\" IN (0, 1)), \"speech_rate\" TEXT NOT NULL DEFAULT 'normal', \"voice_id\" TEXT NULL, \"voice_style\" TEXT NOT NULL DEFAULT 'cheerful', \"less_motion\" INTEGER NOT NULL DEFAULT 0 CHECK (\"less_motion\" IN (0, 1)), \"music_on\" INTEGER NOT NULL DEFAULT 1 CHECK (\"music_on\" IN (0, 1)), \"wear_salakot\" INTEGER NOT NULL DEFAULT 0 CHECK (\"wear_salakot\" IN (0, 1)), \"wear_garland\" INTEGER NOT NULL DEFAULT 0 CHECK (\"wear_garland\" IN (0, 1)), \"wear_sunglasses\" INTEGER NOT NULL DEFAULT 0 CHECK (\"wear_sunglasses\" IN (0, 1)), \"pot_pattern\" TEXT NOT NULL DEFAULT 'plain', PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "leaves_log",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"leaves_log\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"amount\" INTEGER NOT NULL, \"reason\" TEXT NOT NULL, \"plant_id\" TEXT NULL, \"attempt_id\" INTEGER NULL, \"created_at\" TEXT NOT NULL);"
        }
      ]
    },
    {
      "name": "plant_progress",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"plant_progress\" (\"plant_id\" TEXT NOT NULL, \"explored_at\" TEXT NULL, \"parts_found\" INTEGER NOT NULL DEFAULT 0, \"all_parts_at\" TEXT NULL, \"quiz_done_at\" TEXT NULL, \"best_score\" INTEGER NULL, PRIMARY KEY (\"plant_id\"));"
        }
      ]
    },
    {
      "name": "quiz_attempts",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"quiz_attempts\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"kind\" TEXT NOT NULL, \"plant_id\" TEXT NULL, \"total\" INTEGER NOT NULL, \"started_at\" TEXT NOT NULL, \"finished_at\" TEXT NULL, \"score\" INTEGER NULL);"
        }
      ]
    },
    {
      "name": "quiz_answers",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"quiz_answers\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"attempt_id\" INTEGER NOT NULL REFERENCES quiz_attempts (id) ON DELETE CASCADE, \"question_id\" TEXT NOT NULL, \"chosen\" TEXT NOT NULL, \"correct\" INTEGER NOT NULL CHECK (\"correct\" IN (0, 1)), \"answered_at\" TEXT NOT NULL, UNIQUE (\"attempt_id\", \"question_id\"));"
        }
      ]
    },
    {
      "name": "purchases",
      "sql": [
